{
  "name": "evlos",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "dev": "tsc -b && node --env-file-if-exists=.env apps/api/dist/index.js",
    "dev:web": "vite apps/web",
    "db:setup": "tsc -b && node --env-file-if-exists=.env apps/api/dist/db/setup.js",
    "rector:create": "tsc -b && node --env-file-if-exists=.env apps/api/dist/create-rector.js",
    "students:load": "tsc -b && node --env-file-if-exists=.env apps/api/dist/load-students.js"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
