# Copy to deploy/.env on the VM and fill in real values. Never commit .env.
# Compose reads this file for the api container and for ${...} in docker-compose.yml.

# Password of the evlos database user. Use letters and digits only: a $ would be read by Compose.
POSTGRES_PASSWORD=change-me

# Behind the edge Caddy and served over HTTPS, so both are true here (see the root .env.example).
TRUST_PROXY=true
COOKIE_SECURE=true

# The address the Rector opens EVLOS at; a password reset email links to its /reset-password.
PUBLIC_URL=https://evlos.34-55-12-141.sslip.io

# The Device uploads here. Must match the port Compose publishes and the Device's setting.
DEVICE_PORT=8081
PAGE_PORT=3000
PUBLIC_PORT=3001

# Email through Gmail: a 16-character Google app password, never the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=the app password, without spaces
EMAIL_FROM=EVLOS <your.address@gmail.com>
