# Copy to .env and fill in real values. Never commit .env.
# Only variables the code actually reads belong here; add new ones in the same pull request.

# Development database (PostgreSQL installed on this machine).
DATABASE_URL=postgres://evlos:change-me@localhost:5432/evlos

# Port the Device uploads to. Must match the Device's Cloud server setting.
DEVICE_PORT=8081

# Port the Rector's page reads from. This machine only; Caddy adds HTTPS in front of it on the VM.
PAGE_PORT=3000

# true only when the site is served over HTTPS (the VM), so the login cookie is never sent in clear.
COOKIE_SECURE=false

# The address the Rector opens EVLOS at. A forgotten-password email links to its /reset-password
# page. On this machine it is the page from npm run dev:web; on the VM, the HTTPS address.
# Leave it empty and no reset link is sent.
PUBLIC_URL=http://localhost:5173

# Email. Leave SMTP_HOST empty and emails stay queued in the outbox, unsent.
# Locally, use Mailpit: it catches every email on port 1025 and shows it at http://localhost:8025,
# so nothing reaches a real inbox.
# For real sending through Gmail, use instead (the password is a 16-character Google app password,
# made under Google Account > Security > 2-Step Verification > App passwords, never the account password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your.address@gmail.com
#   SMTP_PASSWORD=the app password, without spaces
#   EMAIL_FROM=EVLOS <your.address@gmail.com>
# Check the settings with: npm run email:test -- you@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# The sender shown on every email.
EMAIL_FROM=EVLOS <evlos@localhost>
# Who receives the Review Reminder, Daily Report and Monthly Report is not set here: the
# Rector adds the Report Recipients on the Settings page.

# Test database. Tests may wipe it. Must never point at the development database.
TEST_DATABASE_URL=postgres://evlos:change-me@localhost:5432/evlos_test
